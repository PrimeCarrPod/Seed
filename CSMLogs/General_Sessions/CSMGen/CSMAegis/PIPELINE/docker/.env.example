# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate strong values with: openssl rand -base64 48
NODE_ENV=development
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@foundry-db:5432/REPLACE_DB
REDIS_URL=redis://foundry-redis:6379
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
POSTGRES_DB=REPLACE_DB
GF_SECURITY_ADMIN_USER=REPLACE_ADMIN_USER
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
GF_AUTH_ANONYMOUS_ENABLED=false
