+    private void checkForUpdates() {
+        new Thread(() -> {
+            String latest = fetchLatestVersion();
+            runOnUiThread(() -> {
+                if (latest != null && isNewerVersion(latest, "1.0.90")) {
+                    latestVersion = latest;
+                    injectJs("UI.showUpdateMenu('" + latestVersion + "')");
+                }
+            });
+        }).start();
