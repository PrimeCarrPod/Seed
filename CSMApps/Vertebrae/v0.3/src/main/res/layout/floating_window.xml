<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Window border for focus indication -->
    <View
        android:id="@+id/window_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@color/surface"
        android:orientation="vertical">

        <!-- Header bar -->
        <LinearLayout
            android:id="@+id/window_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/surface_elevated"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vertebrae Session"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <Button
                android:id="@+id/btn_minimize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="−"
                android:textSize="18sp"
                android:background="@color/transparent"
                android:textColor="@color/on_surface"
                android:contentDescription="Minimize" />

            <Button
                android:id="@+id/btn_maximize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="□"
                android:textSize="16sp"
                android:background="@color/transparent"
                android:textColor="@color/on_surface"
                android:contentDescription="Maximize" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="×"
                android:textSize="20sp"
                android:background="@color/transparent"
                android:textColor="@color/error"
                android:contentDescription="Close" />

        </LinearLayout>

        <!-- WebView container -->
        <FrameLayout
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Resize handle -->
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_resize_handle"
            android:contentDescription="Resize"
            android:alpha="0.3" />

    </LinearLayout>

</FrameLayout>