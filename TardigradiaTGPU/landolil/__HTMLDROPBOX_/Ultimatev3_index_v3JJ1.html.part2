<script id="render-vert" type="x-shader/x-vertex">
// render.vert - GPU Particle Render Vertex Shader (WebGL2)
// Reads position from texture and transforms to clip space

#version 300 es
precision highp float;

in uint vertexID;
out vec3 vColor;
out float vSize;
out vec3 vPosition;

uniform sampler2D uPositionTexture;
uniform float uTime;
uniform float uPointSize;

#define WIDTH 512.0
#define HEIGHT 512.0
#define MAX_PARTICLES 150000

// Color palette for 52 particle types
vec3 colors[52];

void initColors() {
    colors[0] = vec3(0.22, 0.74, 0.97);   // electron
    colors[1] = vec3(0.91, 0.47, 0.98);   // muon
    colors[2] = vec3(0.75, 0.52, 0.99);   // tau
    colors[3] = vec3(0.40, 0.91, 0.97);   // e_nu
    colors[4] = vec3(0.40, 0.91, 0.97);   // mu_nu
    colors[5] = vec3(0.40, 0.91, 0.97);   // tau_nu
    colors[6] = vec3(0.98, 0.74, 0.14);   // up_quark
    colors[7] = vec3(0.38, 0.65, 0.98);   // down_quark
    colors[8] = vec3(0.98, 0.74, 0.14);   // charm_quark
    colors[9] = vec3(0.38, 0.65, 0.98);   // strange_quark
    colors[10] = vec3(0.98, 0.74, 0.14);  // top_quark
    colors[11] = vec3(0.38, 0.65, 0.98);  // bottom_quark
    colors[12] = vec3(0.99, 0.94, 0.54);  // photon
    colors[13] = vec3(0.97, 0.45, 0.09);  // gluon
    colors[14] = vec3(0.98, 0.44, 0.52);  // w_boson
    colors[15] = vec3(0.65, 0.55, 0.98);  // z_boson
    colors[16] = vec3(0.82, 0.98, 0.84);  // graviton
    colors[17] = vec3(0.92, 0.28, 0.60);  // higgs
    colors[18] = vec3(0.96, 0.25, 0.37);  // proton
    colors[19] = vec3(0.58, 0.64, 0.72);  // neutron
    colors[20] = vec3(0.53, 0.94, 0.67);  // pion_plus
    colors[21] = vec3(0.53, 0.94, 0.67);  // pion_minus
    colors[22] = vec3(0.53, 0.94, 0.67);  // pion_zero
    colors[23] = vec3(0.99, 0.83, 0.30);  // kaon_plus
    colors[24] = vec3(0.99, 0.83, 0.30);  // kaon_minus
    colors[25] = vec3(0.06, 0.73, 0.51);  // axion
    colors[26] = vec3(0.66, 0.33, 0.96);  // neutralino
    colors[27] = vec3(0.82, 0.98, 0.84);  // gravitino
    colors[28] = vec3(0.30, 0.11, 0.58);  // demon
    colors[29] = vec3(0.97, 0.45, 0.09);  // glueball
    colors[30] = vec3(0.13, 0.83, 0.90);  // tardigrade
    colors[31] = vec3(0.12, 0.11, 0.29);  // dark_matter
    colors[32] = vec3(0.22, 0.74, 0.97);  // prime_particle
    colors[33] = vec3(0.06, 0.73, 0.51);  // holographic
    colors[34] = vec3(0.66, 0.33, 0.96);  // swarm_mode
    colors[35] = vec3(0.90, 0.50, 0.20);  // exotic_1
    colors[36] = vec3(0.20, 0.90, 0.50);  // exotic_2
    colors[37] = vec3(0.50, 0.20, 0.90);  // exotic_3
    colors[38] = vec3(0.90, 0.20, 0.50);  // exotic_4
    colors[39] = vec3(0.20, 0.50, 0.90);  // exotic_5
    colors[40] = vec3(0.50, 0.90, 0.20);  // exotic_6
    colors[41] = vec3(0.95, 0.95, 0.20);  // exotic_7
    colors[42] = vec3(0.20, 0.95, 0.95);  // exotic_8
    colors[43] = vec3(0.95, 0.20, 0.95);  // exotic_9
    colors[44] = vec3(0.70, 0.70, 0.70);  // exotic_10
    colors[45] = vec3(0.40, 0.40, 0.40);  // exotic_11
    colors[46] = vec3(0.80, 0.80, 0.80);  // exotic_12
    colors[47] = vec3(0.60, 0.60, 0.60);  // exotic_13
    colors[48] = vec3(0.30, 0.30, 0.30);  // exotic_14
    colors[49] = vec3(0.90, 0.90, 0.90);  // exotic_15
    colors[50] = vec3(0.10, 0.10, 0.10);  // exotic_16
    colors[51] = vec3(0.50, 0.50, 0.50);  // exotic_17
}

float sizes[52];

void initSizes() {
    sizes[0] = 0.35; sizes[1] = 0.6; sizes[2] = 0.7; sizes[3] = 0.25; sizes[4] = 0.25; sizes[5] = 0.25;
    sizes[6] = 0.5; sizes[7] = 0.5; sizes[8] = 0.55; sizes[9] = 0.55; sizes[10] = 0.6; sizes[11] = 0.6;
    sizes[12] = 0.45; sizes[13] = 0.4; sizes[14] = 1.0; sizes[15] = 1.0; sizes[16] = 0.3;
    sizes[17] = 1.2; sizes[18] = 0.8; sizes[19] = 0.75; sizes[20] = 0.55; sizes[21] = 0.55; sizes[22] = 0.55;
    sizes[23] = 0.6; sizes[24] = 0.6; sizes[25] = 0.3; sizes[26] = 0.9; sizes[27] = 0.8; sizes[28] = 0.35;
    sizes[29] = 1.4; sizes[30] = 1.5; sizes[31] = 1.0; sizes[32] = 0.2; sizes[33] = 0.25; sizes[34] = 0.8;
    sizes[35] = 0.5; sizes[36] = 0.5; sizes[37] = 0.5; sizes[38] = 0.5; sizes[39] = 0.5; sizes[40] = 0.5;
    sizes[41] = 0.5; sizes[42] = 0.5; sizes[43] = 0.5; sizes[44] = 0.5; sizes[45] = 0.5; sizes[46] = 0.5;
    sizes[47] = 0.5; sizes[48] = 0.5; sizes[49] = 0.5; sizes[50] = 0.5; sizes[51] = 0.5;
}

void main() {
    initColors();
    initSizes();
    
    uint idx = vertexID;
    
    if (idx >= uint(MAX_PARTICLES)) {
        gl_Position = vec4(0.0);
        gl_PointSize = 0.0;
        return;
    }
    
    // Calculate UV from vertex ID
    float u = float(idx % uint(WIDTH)) / WIDTH + 0.5 / WIDTH;
    float v = float(idx / uint(WIDTH)) / HEIGHT + 0.5 / HEIGHT;
    vec2 uv = vec2(u, v);
    
    // Read position from texture
    vec4 posData = texture(uPositionTexture, uv);
    vec3 pos = posData.xyz;
    float typeId = posData.w;
    
    vPosition = pos;
    
    // Get color by type
    int typeIdx = int(typeId + 0.5);
    if (typeIdx >= 0 && typeIdx < 52) {
        vColor = colors[typeIdx];
        vSize = sizes[typeIdx] * uPointSize;
    } else {
        vColor = vec3(0.5);
        vSize = 0.5 * uPointSize;
    }
    
    // Transform to clip space
    vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
    gl_PointSize = vSize * (300.0 / -mvPosition.z);
    gl_Position = projectionMatrix * mvPosition;
}
    </script>
    <script id="render-frag" type="x-shader/x-fragment">
// render.frag - GPU Particle Render Fragment Shader (WebGL2)
// Renders point sprites with radial gradient and color by type

#version 300 es
precision highp float;

in vec3 vColor;
in float vSize;
in vec3 vPosition;

out vec4 fragColor;

uniform float uTime;
uniform float uBloomStrength;

void main() {
    // Radial gradient for point sprite
    vec2 center = gl_PointCoord - vec2(0.5);
    float dist = length(center);
    
    // Smooth circular falloff
    float alpha = 1.0 - smoothstep(0.0, 0.5, dist);
    
    // Add subtle pulse based on time and position
    float pulse = 0.8 + 0.2 * sin(uTime * 2.0 + vPosition.x * 0.05 + vPosition.y * 0.03);
    alpha *= pulse;
    
    // Add slight color variation based on position
    vec3 finalColor = vColor * (0.9 + 0.1 * sin(uTime + vPosition.z * 0.1));
    
    // Bloom enhancement for bright particles
    float brightness = dot(finalColor, vec3(0.299, 0.587, 0.114));
    if (brightness > 0.7) {
        finalColor *= uBloomStrength;
    }
    
    fragColor = vec4(finalColor, alpha);
}
    </script>
</head>
<body class="w-full h-screen relative">
    <div id="canvas-container"></div>
    <div id="flight-progress" style="width:0%"></div>
    <!-- Header -->
    <div id="hud-header" class="absolute top-0 left-0 w-full p-3 z-20 pointer-events-none flex justify-between items-start bg-gradient-to-b from-black/90 to-transparent">
        <div class="pointer-events-auto">
            <h1 class="text-2xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 drop-shadow-[0_0_12px_rgba(34,211,238,0.9)]">
                ULTIMATEv3 PRIME ELECTRON HOLOGRAPHIC UNIVERSE v3.0 JJ1
            </h1>
            <p class="text-xs text-cyan-300 mt-1 opacity-80">
                <span class="font-bold text-white">Monistic Engine v3.0 JJ1</span> — GPU Compute Shaders · Reinman One-Electron · 3.67B Prime Gaps · 0.0019% Accuracy
                <span class="text-gray-500 ml-2">52-particle species · 150,000 particles · Meta-Depth ω+3 · Base-π Encoding · Everything is Prime</span>
            </p>
        </div>
        <div class="pointer-events-auto flex items-center gap-2 mt-1 flex-wrap">
            <button id="btn-toggle-hud" class="btn btn-cyan" onclick="UI.toggleHUD()">☰ Hide</button>
            <button id="btn-flight" class="btn btn-purple" onclick="Flight.toggle()">✈ Flight <label style="margin-left:8px;cursor:pointer;"><input type="checkbox" id="flight-lock" onchange="Flight.lock=this.checked" title="Infinite flight mode"> Lock</label></button>
            <button id="btn-glueball" class="btn btn-glue" onclick="sim.spawnGlueball()">Glueball</button>
            <button id="btn-prime" class="btn btn-prime" onclick="sim.togglePrimeMode()">Prime Gaps</button>
            <button id="btn-meta" class="btn btn-meta" onclick="sim.cycleMetaDepth()">Meta-Depth</button>
            <button id="btn-reinman" class="btn btn-reinman" onclick="sim.toggleReinmanMode()">Reinman</button>
            <div id="live-badge" class="text-green-400 text-xs orbitron font-bold animate-pulse ml-3 hidden md:block">● LIVE JJ1 ULTIMATEv3 GPU</div>
            <div class="gpu-badge ml-2">GPU COMPUTE</div>
        </div>
    </div>

    <!-- Left Panel -->
    <div id="hud-left" class="hud absolute bottom-4 left-4 z-20 w-80 flex flex-col gap-3 pointer-events-none">
        <div class="hud p-3 pointer-events-auto">
            <h3 class="text-cyan-400 text-xs orbitron uppercase tracking-wider border-b border-cyan-900/50 pb-1 mb-2">Evolution Cycle</h3>
            <div class="flex justify-between items-end mb-1">
                <span class="text-gray-400 text-xs">Loop Time</span>
                <span id="loop-timer" class="text-xl font-mono font-bold text-white">00.00s</span>
            </div>
            <div class="w-full bg-gray-900 h-1 rounded-full overflow-hidden">
                <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-purple-500 transition-none" style="width:0%"></div>
            </div>
            <div class="flex justify-between text-xs text-gray-500 mt-1">
                <span>Cycle <span id="cycle-count" class="text-cyan-300 font-bold">1</span></span>
                <span>Max <span id="max-dur" class="text-cyan-300">5.0s</span></span>
            </div>
        </div>

        <div class="hud p-3 pointer-events-auto">
            <h3 class="text-purple-400 text-xs orbitron uppercase tracking-wider border-b border-purple-900/50 pb-1 mb-2">Particle Legend (52 Species)</h3>
            <div class="grid grid-cols-3 gap-0.5 text-xs particle-legend" id="particle-legend"></div>
        </div>

        <div class="hud p-3 pointer-events-auto">
            <h3 class="text-yellow-400 text-xs orbitron uppercase tracking-wider border-b border-yellow-900/50 pb-1 mb-2">Prime Gap Physics & Reinman</h3>
            <div id="prime-gap-display" class="text-xs font-mono text-cyan-300"></div>
            <div id="meta-depth-display" class="text-xs font-mono text-purple-300 mt-1"></div>
            <div id="reinman-display" class="text-xs font-mono text-orange-300 mt-1"></div>
        </div>

        <div class="hud p-3 pointer-events-auto max-h-32 overflow-y-auto scrollable">
            <h3 class="text-purple-400 text-xs orbitron uppercase tracking-wider border-b border-purple-900/50 pb-1 mb-2">Quantum Events</h3>
            <ul id="event-log" class="text-xs space-y-0.5 font-mono"></ul>
        </div>
    </div>