<!-- Right Panel -->
    <div id="hud-right" class="hud absolute bottom-4 right-4 z-20 w-80 flex flex-col gap-3 pointer-events-none">
        <div class="hud p-3 pointer-events-auto">
            <h3 class="text-green-400 text-xs orbitron uppercase tracking-wider border-b border-green-900/50 pb-1 mb-2">Simulation Controls</h3>
            <div class="grid grid-cols-3 gap-1.5 text-xs mb-3">
                <button onclick="sim.perturb()" class="btn btn-red">Perturb</button>
                <button onclick="sim.toggleTrails()" class="btn btn-purple">Trails</button>
                <button onclick="sim.spawnDemon()" class="btn btn-yellow">Demon</button>
                <button onclick="sim.triggerFusion()" class="btn btn-green">Fusion</button>
                <button onclick="sim.spawnGlueball()" class="btn btn-glue">Glueball</button>
                <button onclick="sim.toggleSwarm()" class="btn btn-purple">Swarm</button>
                <button onclick="sim.triggerQCD()" class="btn btn-glue">QCD</button>
                <button onclick="sim.triggerEW()" class="btn btn-cyan">Electroweak</button>
                <button onclick="sim.triggerGravity()" class="btn btn-green">Gravity</button>
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-xs text-gray-400"><span>Larmor Freq</span><span id="speed-val" class="text-cyan-300">1.0×</span></div>
                <input type="range" min="0.1" max="4" step="0.1" value="1.0" class="w-full h-1 bg-gray-700 rounded cursor-pointer" oninput="sim.setSpeed(this.value)">
                <div class="flex justify-between text-xs text-gray-400"><span>Density</span><span id="dens-val" class="text-cyan-300">150000</span></div>
                <input type="range" min="50000" max="300000" step="10000" value="150000" class="w-full h-1 bg-gray-700 rounded cursor-pointer" oninput="sim.setDensity(this.value)">
            </div>
        </div>

        <div class="hud p-3 pointer-events-auto">
            <h3 class="text-yellow-400 text-xs orbitron uppercase tracking-wider border-b border-yellow-900/50 pb-1 mb-2">Benevolence Monitor</h3>
            <div style="position:relative;width:100%;height:100px"><canvas id="metricsChart"></canvas></div>
            <div class="mt-1 text-xs text-gray-500 text-center">Action (S) · Benevolence (B=C·F·S) · Coherence (C) · Glueball (G)</div>
        </div>

        <div class="hud p-3 pointer-events-auto">
            <div class="flex justify-between items-center mb-1">
                <h3 class="text-cyan-400 text-xs orbitron uppercase tracking-wider">Active Equations</h3>
                <button onclick="toggleEquationDisplay()" class="btn btn-cyan text-[9px] px-2 py-0">Toggle</button>
            </div>
            <div id="equation-display" class="text-xs font-mono text-cyan-300 max-h-24 overflow-y-auto scrollable"></div>
        </div>
    </div>

    <!-- Meta-Depth Indicator -->
    <div id="meta-depth-indicator" class="absolute top-20 left-1/2 transform -translate-x-1/2 z-20 hud p-2 pointer-events-none">
        <div class="text-center">
            <div class="text-xs text-purple-400 orbitron">META-DEPTH</div>
            <div id="meta-depth-value" class="text-2xl font-bold text-white">ω+3</div>
        </div>
    </div>
    <!-- Reinman One-Electron Indicator -->
    <div id="reinman-indicator" class="absolute top-20 right-20 z-20 hud p-2 pointer-events-none hidden">
        <div class="text-center">
            <div class="text-xs text-orange-400 orbitron">REINMAN MODE</div>
            <div id="reinman-value" class="text-xl font-bold reinman-badge">1 ELECTRON</div>
        </div>
    </div>
    <script>
