#!/bin/sh
# Gradle wrapper script - downloads Gradle if not present
# This is a minimal version; for production use the official wrapper

set -e

GRADLE_VERSION="8.5"
GRADLE_DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
GRADLE_HOME="${HOME}/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin"

# Find or download Gradle
if [ ! -d "${GRADLE_HOME}" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    mkdir -p "${GRADLE_HOME}"
    cd "${GRADLE_HOME}"
    curl -L -o gradle.zip "${GRADLE_DIST_URL}"
    unzip -q gradle.zip
    rm gradle.zip
    # Find the extracted directory
    GRADLE_DIR=$(find . -maxdepth 1 -type d -name "gradle-${GRADLE_VERSION}" | head -1)
    if [ -n "${GRADLE_DIR}" ]; then
        mv "${GRADLE_DIR}"/* .
        rmdir "${GRADLE_DIR}"
    fi
fi

# Find gradle executable
GRADLE_EXEC=$(find "${GRADLE_HOME}" -name "gradle" -type f -executable | head -1)

if [ -z "${GRADLE_EXEC}" ]; then
    echo "Error: Could not find gradle executable"
    exit 1
fi

exec "${GRADLE_EXEC}" "$@"