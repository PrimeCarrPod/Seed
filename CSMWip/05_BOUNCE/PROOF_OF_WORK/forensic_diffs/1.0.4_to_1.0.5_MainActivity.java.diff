+    public void startP2pBroadcast(String ssidCode) {
+        if (p2pManager == null || p2pChannel == null) {
+            injectJs("Bounce.onBroadcastStatus({status:'unsupported'})");
+            return;
+        }
+
+        // Stop any existing broadcast
+        p2pManager.clearLocalServices(p2pChannel, new WifiP2pManager.ActionListener() {
+            public void onSuccess() {}
+            public void onFailure(int r) {}
+        });
+
+        // Register Bonjour service with TAF code as instance name
+        Map<String, String> record = new HashMap<>();
+        record.put("taf", ssidCode);
+        record.put("v", "1.0.5");
+        record.put("app", "Bounce");
+
+        WifiP2pDnsSdServiceInfo serviceInfo = WifiP2pDnsSdServiceInfo.newInstance(
+            "_bounce._tcp", ssidCode, record);
+
+        p2pManager.addLocalService(p2pChannel, serviceInfo, new WifiP2pManager.ActionListener() {
+            public void onSuccess() {
+                broadcasting = true;
+                injectJs("Bounce.onBroadcastStatus({status:'broadcasting',ssid:'" + ssidCode + "',method:'WiFi-Direct'})");
+                Toast.makeText(MainActivity.this, "Broadcasting: " + ssidCode, Toast.LENGTH_SHORT).show();
+            }
+            public void onFailure(int reason) {
+                broadcasting = false;
+                String msg = reason == 0 ? "P2P_UNSUPPORTED" : reason == 1 ? "BUSY" : reason == 2 ? "NO_SERVICE_REQUESTS" : "ERR_" + reason;
+                injectJs("Bounce.onBroadcastStatus({status:'failed',reason:'" + msg + "'})");
+                Toast.makeText(MainActivity.this, "Broadcast failed: " + msg, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    public void stopP2pBroadcast() {
+        if (p2pManager == null || p2pChannel == null) return;
+        p2pManager.clearLocalServices(p2pChannel, new WifiP2pManager.ActionListener() {
+            public void onSuccess() {
+                broadcasting = false;
+                injectJs("Bounce.onBroadcastStatus({status:'stopped'})");
+            }
+            public void onFailure(int r) {
+                injectJs("Bounce.onBroadcastStatus({status:'error',reason:'stop_failed'})");
+            }
+        });
+    }
