+    setTimeout(function(){LockScreen.lPressed=false;LockScreen.rPressed=false},500)},
+};
+document.getElementById('lock-btn-l').addEventListener('pointerdown',function(e){e.preventDefault();LockScreen.tryUnlock('L')});
