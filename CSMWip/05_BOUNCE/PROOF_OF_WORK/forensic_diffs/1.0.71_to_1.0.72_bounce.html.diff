+<script>
+var LockScreen={active:false,lPressed:false,rPressed:false,
+  enable(){this.active=true;document.getElementById('lock-overlay').style.display='block';
+    document.getElementById('lock-btn-l').style.display='flex';document.getElementById('lock-btn-r').style.display='flex';
+    document.getElementById('btn-lock').textContent='LOCKED';this.lPressed=false;this.rPressed=false},
